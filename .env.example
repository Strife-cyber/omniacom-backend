# =============================================================================
# OMNIACOM BACKEND - Exemple de variables d'environnement
# =============================================================================
# Copiez ce fichier en .env et remplacez les valeurs par defaut.
# =============================================================================

# --- Base de donnees PostgreSQL ---
DATABASE_URL="postgresql://postgres:admin@localhost:5432/omniacom?schema=public"

# --- Serveur Express ---
PORT=3000
NODE_ENV=development

# --- CORS ---
CORS_ORIGINS=http://localhost:3000,http://localhost:5173

# --- JWT (Authentification) ---
JWT_SECRET=votre-cle-secrete-tres-longue-et-aleatoire
JWT_EXPIRES_IN=24h
JWT_REFRESH_EXPIRES_IN=7d
