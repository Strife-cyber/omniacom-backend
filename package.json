{
  "name": "omniacom-backend",
  "version": "1.0.0",
  "description": "API RESTful pour OmniaCom - Backend Node.js avec Express, Prisma et PostgreSQL",
  "main": "src/server.js",
  "type": "module",
  "scripts": {
    "dev": "cross-env NODE_OPTIONS=\"--experimental-strip-types\" nodemon --watch src --watch .env --ext js,mjs,cjs,json,ts src/server.js",
    "start": "node --experimental-strip-types src/server.js",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev",
    "prisma:reset": "prisma migrate reset",
    "prisma:studio": "prisma studio",
    "prisma:seed": "node --experimental-strip-types prisma/seed.js",
    "openapi:generate": "node --experimental-strip-types scripts/generate-openapi.js",
    "generate": "node --experimental-strip-types scripts/generate/index.js",
    "setup": "npm install && prisma generate && prisma migrate dev",
    "test": "echo \"Error: no test specified\" && exit 1"
  },
  "keywords": [
    "api",
    "express",
    "prisma",
    "postgresql",
    "omnia"
  ],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "@prisma/adapter-pg": "^7.8.0",
    "@prisma/client": "^7.8.0",
    "bcryptjs": "^3.0.2",
    "cors": "^2.8.6",
    "dotenv": "^17.4.2",
    "exceljs": "^4.4.0",
    "express": "^5.2.1",
    "jsonwebtoken": "^9.0.2",
    "morgan": "^1.11.0",
    "multer": "^2.2.0",
    "pg": "^8.21.0",
    "swagger-jsdoc": "^6.2.8",
    "swagger-ui-express": "^5.0.1"
  },
  "devDependencies": {
    "cross-env": "^7.0.3",
    "nodemon": "^3.1.14",
    "prisma": "^7.8.0"
  },
  "prisma": {
    "seed": "node --experimental-strip-types prisma/seed.js"
  }
}
